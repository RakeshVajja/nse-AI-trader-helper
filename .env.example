# ==========================================
# NSE AI Trading Agent & Simulator Environment
# ==========================================

# Application
PROJECT_NAME="NSE AI Trading Agent & Simulator"
ENVIRONMENT=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nse_trader
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nse_trader
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/nse_trader

# Redis (Cache & Session State)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Default Trading & Risk Parameters
DEFAULT_INITIAL_CAPITAL=100000.0
DEFAULT_MAX_RISK_PER_TRADE=0.02
DEFAULT_MAX_POSITION_EXPOSURE=0.25
DEFAULT_MAX_DAILY_LOSS=0.05
DEFAULT_SLIPPAGE_PCT=0.0005
DEFAULT_BROKERAGE_PCT=0.0003

# Market Data Settings
DATA_CACHE_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS_PER_MINUTE=30
